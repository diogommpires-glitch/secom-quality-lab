  "components": {
    "schemas": {
      "AdvanceRequest": {
        "properties": {
          "expected_cursor": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Cursor"
          },
          "steps": {
            "type": "integer",
            "title": "Steps",
            "default": 20
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_cursor"
        ],
        "title": "AdvanceRequest"
      },
      "BatchResponse": {
        "properties": {
          "batch_id": {
            "type": "string",
            "title": "Batch Id"
          },
          "row_count": {
            "type": "integer",
            "title": "Row Count"
          },
          "bundle_id": {
            "type": "string",
            "title": "Bundle Id"
          },
          "model_id": {
            "type": "string",
            "title": "Model Id"
          },
          "validation_issues": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Validation Issues"
          },
          "eligible_count": {
            "type": "integer",
            "title": "Eligible Count"
          },
          "review_capacity": {
            "type": "integer",
            "title": "Review Capacity"
          },
          "abstain_count": {
            "type": "integer",
            "title": "Abstain Count"
          },
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/PredictionResponse"
            },
            "type": "array",
            "title": "Predictions"
          },
          "queue_policy_id": {
            "type": "string",
            "title": "Queue Policy Id"
          },
          "replayed": {
            "type": "boolean",
            "title": "Replayed",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "batch_id",
          "row_count",
          "bundle_id",
          "model_id",
          "validation_issues",
          "eligible_count",
          "review_capacity",
          "abstain_count",
          "predictions",
          "queue_policy_id"
        ],
        "title": "BatchResponse"
      },
      "Body_create_batch_api_v1_batches_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "client_request_id": {
            "type": "string",
            "title": "Client Request Id"
          }
        },
        "type": "object",
        "required": [
          "file",
          "client_request_id"
        ],
        "title": "Body_create_batch_api_v1_batches_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PredictionRequest": {
        "properties": {
          "record_id": {
            "type": "string",
            "title": "Record Id"
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed At"
          },
          "sensors": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Sensors"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "record_id",
          "sensors"
        ],
        "title": "PredictionRequest"
      },
      "PredictionResponse": {
        "properties": {
          "prediction_id": {
            "type": "string",
            "title": "Prediction Id"
          },
          "record_id": {
            "type": "string",
            "title": "Record Id"
          },
          "risk_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Score"
          },
          "calibrated_probability": {
            "type": "null",
            "title": "Calibrated Probability"
          },
          "score_kind": {
            "type": "string",
            "const": "uncalibrated",
            "title": "Score Kind"
          },
          "calibration_status": {
            "type": "string",
            "const": "not_validated",
            "title": "Calibration Status",
            "default": "not_validated"
          },
          "feature_schema_version": {
            "type": "string",
            "title": "Feature Schema Version",
            "default": "secom-sensors-v1"
          },
          "quality_status": {
            "type": "string",
            "enum": [
              "valid",
              "warning",
              "abstain"
            ],
            "title": "Quality Status"
          },
          "quality_reason_codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Quality Reason Codes"
          },
          "missingness": {
            "type": "number",
            "title": "Missingness"
          },
          "range_violation_count": {
            "type": "integer",
            "title": "Range Violation Count"
          },
          "input_fingerprint": {
            "type": "string",
            "title": "Input Fingerprint"
          },
          "bundle_id": {
            "type": "string",
            "title": "Bundle Id"
          },
          "model_id": {
            "type": "string",
            "title": "Model Id"
          },
          "rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rank"
          },
          "review_recommended": {
            "type": "boolean",
            "title": "Review Recommended",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "prediction_id",
          "record_id",
          "risk_score",
          "score_kind",
          "quality_status",
          "quality_reason_codes",
          "missingness",
          "range_violation_count",
          "input_fingerprint",
          "bundle_id",
          "model_id"
        ],
        "title": "PredictionResponse"
      },
      "ReplayRequest": {
        "properties": {
          "scenario": {
            "type": "string",
            "title": "Scenario",
            "default": "baseline"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ReplayRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
